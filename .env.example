# ============================================================
# InboxPilot environment template
# Copy to .env and fill in real values. Never commit real secrets.
# ============================================================

# ---- App (required) ----
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS. Comma-separate to allow several
# (e.g. http://localhost:5173,https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# ---- Database (required) ----
MONGODB_URI=mongodb://localhost:27017/inboxpilot
# Optional: only needed if Node cannot resolve MongoDB Atlas SRV records on
# your local DNS. Comma-separated resolver IPs.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- JWT (required) ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Google OAuth and Gmail API (required) ----
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Primary callback URL. GOOGLE_REDIRECT_URI is an optional fallback (one is enough).
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Keep Gmail read-only. Do not widen this scope.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ---- Gemini AI (required for AI features) ----
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ---- Token encryption (required) ----
# Used to encrypt Gmail OAuth tokens at rest (AES-256-CBC).
# If unset, the app falls back to JWT_SECRET; if neither is set, token
# encryption fails clearly at runtime. Generate a 64-char hex string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# ---- Frontend (required for the client build) ----
# Local dev: leave as /api to use the Vite dev proxy, or point to the backend.
# Vercel: set to your Render backend URL, e.g. https://your-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# ============================================================
# Optional / reserved — not currently read by the code.
# Safe to leave unset. Kept for future features.
# ============================================================
# SERVER_URL=http://localhost:5000
# COOKIE_SECRET=
# SESSION_SECRET=
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
